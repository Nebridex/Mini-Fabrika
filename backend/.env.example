NODE_ENV=production
PORT=3000
TRUST_PROXY=true
APP_ORIGIN=https://minifabrika.com
PUBLIC_API_URL=https://api.minifabrika.com
DATABASE_URL=postgresql://user:password@host:5432/minifabrika
DATABASE_SSL=true

# Private S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO, etc.)
S3_REGION=auto
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=minifabrika-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# SMTP account authorized to send as info@minifabrika.com
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MiniFabrika <info@minifabrika.com>
BUSINESS_EMAIL=info@minifabrika.com

# At least 32 random bytes. Used for expiring download links sent to the business.
DOWNLOAD_SIGNING_SECRET=
DOWNLOAD_LINK_TTL_SECONDS=604800
MAX_UPLOAD_BYTES=52428800
